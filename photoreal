# Build from the project root (a .dockerignore there keeps the context small):
#   docker build -f Dockerfile.cuda -t egog-splats:cuda128 .
#
# Note: Meta-Passthrough-Camera-API-Samples is a PRIVATE repo — only its
# python conversion scripts/ dir is copied into the image.

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Python 3.11 (22.04 ships 3.10; the tested env is 3.11)
RUN apt-get update && apt-get install -y software-properties-common \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update && apt-get install -y \
      python3.11 python3.11-venv python3.11-dev python3-pip git \
      libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

# uv for fast, reproducible installs
RUN pip3 install --no-cache-dir uv

WORKDIR /work

# The trainer repo (public). Converter scripts come from the build context.
RUN git clone https://github.com/facebookresearch/egocentric_splats.git
COPY Meta-Passthrough-Camera-API-Samples/scripts/ /work/Meta-Passthrough-Camera-API-Samples/scripts/

# No GPU is attached to `docker build`, so torch auto-detects an empty arch
# list and the gsplat compile crashes (IndexError in cpp_extension).
# Pin sm_80 (A100) + PTX so newer GPUs (e.g. sm_90) work via JIT.
ENV TORCH_CUDA_ARCH_LIST="8.0+PTX"

# Patch the repo's MCMC config bug (model/vanilla_gsplat.py reads
# opt.mcmc_strategy.refine_start_iter / refine_stop_iter / min_opacity
# unprefixed, but the YAML only defines the mcmc_-prefixed names ->
# Hydra error on every 3DGS+MCMC run). Adds unprefixed aliases.
COPY docker/fix_mcmc_conf.py /tmp/fix_mcmc_conf.py
RUN python3.11 /tmp/fix_mcmc_conf.py egocentric_splats/conf/opt/simple_gsplat_30K.yaml && rm /tmp/fix_mcmc_conf.py

# Virtualenv + pinned deps (versions are the tested set).
# Order matters: the repo's requirements.txt has unpinned `torchvision`,
# and the latest torchvision hard-pins `torch==<latest>`, which would silently
# upgrade our torch 2.8.0+cu128 to the newest PyPI torch (2.15+cu132).
# Hence: pin torch+torchvision FIRST, then the remaining requirements
# (minus the four packages we pin explicitly) — uv keeps installed versions
# that already satisfy a requirement.
RUN uv venv --python python3.11 .venv \
 && . .venv/bin/activate \
 && uv pip install \
      torch==2.8.0+cu128 torchvision==0.23.0+cu128 --default-index https://download.pytorch.org/whl/cu128 \
 && grep -vE '^(torch|torchvision|gsplat|opencv)' egocentric_splats/requirements.txt > /tmp/reqs.txt \
 && uv pip install -r /tmp/reqs.txt \
 # PyPI gsplat wheel ships NO compiled extension. Force a source build against
 # the container's CUDA 12.8 toolkit. --no-build-isolation: setup.py imports
 # torch for its include path, so the build must run inside the venv.
 # Re-state the torch pin in the SAME command: uv re-resolves gsplat's `torch`
 # dependency and would otherwise silently upgrade torch to the latest PyPI
 # release (2.15+cu132), rebuilding gsplat against the wrong ABI.
 && uv pip install --reinstall --no-binary gsplat --no-build-isolation -v \
      gsplat==1.5.3 torch==2.8.0+cu128 \
      --index https://download.pytorch.org/whl/cu128 \
 # opencv 5.0.0 broke cv2.stereoRectify — pin the tested 4.11
 && uv pip install "opencv-python==4.11.0.86" \
 && rm -rf ~/.cache/uv /tmp/reqs.txt

ENV PATH="/work/.venv/bin:$PATH"
WORKDIR /work/egocentric_splats
